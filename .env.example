DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Retention cleanup
# Enables automatic deletion of old rows so the database does not grow forever.
RETENTION_ENABLED=true
RETENTION_CLEANUP_INTERVAL_MS=900000
RETENTION_BATCH_SIZE=2000
RETENTION_MAX_PASSES=20
AI_REWRITE_RETENTION_HOURS=24
AI_REWRITE_MAX_ROWS=5000
FETCHED_NEWS_RETENTION_HOURS=24
FETCHED_NEWS_MAX_ROWS=10000
SCHEDULER_RUNS_RETENTION_DAYS=30
SCHEDULER_RUNS_MAX_ROWS=2000
API_USAGE_LOG_RETENTION_DAYS=14
API_USAGE_LOG_MAX_ROWS=5000
ADMIN_AUDIT_LOG_RETENTION_DAYS=90
ADMIN_AUDIT_LOG_MAX_ROWS=5000

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
ADMIN_PANEL_MASTER_API_KEY=replace-with-your-master-api-key
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-panel-password
ADMIN_PANEL_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars

# Supabase / Postgres mode
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
# Or pooler:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# DB_PASSWORD can contain the actual password if DATABASE_URL uses [YOUR-PASSWORD] or <YOUR-PASSWORD>.
# DB_SSL_MODE=require
# The same retention settings above work for Supabase/Postgres.
