NODE_ENV=production
PORT=3000
TRUST_PROXY_ENABLED=true
DB_DIALECT=mysql

DB_HOST=your-production-mysql-host
DB_PORT=3306
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password
DB_NAME=gautam_news_bot

# For Supabase / Postgres use:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# Or set SUPABASE_DB_URL to the same value.
# DB_PASSWORD should contain the actual password if DATABASE_URL uses [YOUR-PASSWORD] or <YOUR-PASSWORD>.
# DB_SSL_MODE=require
DB_SSL_MODE=require

# Leave blank when using Puppeteer's downloaded Chrome.
# Point the cache at the directory used by `npm ci` on the target host.
# Render example: /opt/render/project/src/.puppeteer-cache
# Linux VPS example: /srv/news_automation/.puppeteer-cache
BROWSER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=/absolute/path/to/news_automation/.puppeteer-cache

SCHEDULER_ENABLED=true
AI_SCHEDULER_ENABLED=true
SCHEDULER_GOOGLE_RSS_ENABLED=true
SCHEDULER_ARTICLES_PER_CATEGORY_RUN=5
SCHEDULER_PRIMARY_SOURCE_LIMIT=4
DAILY_NEWS_FETCH_LIMIT=450
NEWS_MAX_AGE_HOURS=24
NEWS_REQUIRE_PUBLISHED_DATE=true
SCHEDULER_ACTIVE_START_HOUR=0
SCHEDULER_ACTIVE_END_HOUR=0
SCHEDULER_PEAK_WEIGHT=4
AI_REWRITE_CANDIDATE_LIMIT=30
AI_REWRITES_PER_CATEGORY_RUN=6
AI_REWRITE_ENABLED=true
AI_REWRITE_AUTO_PUBLISH=true
MPINFO_DISTRICT_SCHEDULER_ENABLED=true
MPINFO_DISTRICT_BROWSER_ENABLED=true
MPINFO_DISTRICT_CATEGORY=Madhyapradesh
MPINFO_DISTRICT_SCHEDULER_INTERVAL_MS=1800000
MPINFO_DISTRICT_SCHEDULER_TIMEOUT_MS=2700000
MPINFO_DISTRICT_SCHEDULER_LIMIT=24
MPINFO_DISTRICT_SCHEDULER_SCAN_LIMIT=12
MPINFO_DISTRICT_MAX_AGE_HOURS=48
MPINFO_DISTRICT_SCHEDULER_REWRITE=true
MPINFO_DISTRICT_SCHEDULER_STARTUP_RUN=false
MPINFO_DISTRICT_CONCURRENCY=2
MPINFO_ARTICLE_CONCURRENCY=1
LEGACY_PUBLIC_ROUTES_ENABLED=false

# Legacy shared key support. Prefer client keys managed through /api/v1/admin/clients.
API_KEYS=
MASTER_API_KEY=replace-with-a-long-random-master-secret-at-least-32-chars

# Comma-separated allowed origins. Do not use * in production.
API_CORS_ORIGINS=https://site-one.com,https://www.site-one.com,https://site-two.com

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
REDIS_URL=replace-with-your-redis-url-for-shared-rate-limits

CLIFF_NEWS_API_URL=https://cliff-news-backend.onrender.com/api/articles
CLIFF_NEWS_CATEGORY_ENDPOINTS=
CLIFF_NEWS_PUBLIC_BASE_URL=https://www.thecliffnews.in
CLIFF_NEWS_LANGUAGE=ENGLISH
CLIFF_NEWS_PRIMARY_ENABLED=true
CLIFF_NEWS_DEFAULT_LIMIT=100
CLIFF_NEWS_REQUEST_TIMEOUT_MS=15000
THENEWSAPI_CATEGORIES=general,science,sports,business,health,entertainment,tech,politics,food,travel
ARTICLE_METADATA_TIMEOUT_MS=30000
ARTICLE_IMAGE_RENDER_WAIT_MS=6000
IMAGE_PROXY_EXTRA_HOSTS=c.ndtvimg.com,drop.ndtv.com,images.ctfassets.net,island.lk,www.island.lk,thecliffnews.in,www.thecliffnews.in,cliff-news-backend.onrender.com,static-cdn.toi-media.com,dailypioneer.com,www.dailypioneer.com,pxl-tcdie.terminalfour.net,thehindu.com,www.thehindu.com,cdn.britannica.com
IMAGE_PROXY_EXTRA_HOST_SUFFIXES=ndtvimg.com,ctfassets.net,island.lk,thecliffnews.in,toi-media.com,dailypioneer.com,terminalfour.net,thehindu.com,britannica.com,espncdn.com,upstox.com,weforum.org,nvidia.com,arcpublishing.com,buzzrx.com,cnet.com,cpr.org,dailyfarmer.in,financialexpressdigital.com,gizbot.com,icc-cricket.com,moneycontrol.com,theconversation.com,jagranimages.com,kotaku.com,livemint.com,economictimes.com,futurism.com,geographical.co.uk,imgix.net,cnn.com,licdn.com,medicaldialogues.in,theverge.com,yimg.com,ytimg.com,b-cdn.net,91mobiles.com,thenewsmill.com,cgtn.com,cfr.org,wikimedia.org,aljazeera.com

DEEPSEEK_API_KEY=replace-with-your-production-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Frontend / admin panel
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
ADMIN_PANEL_MASTER_API_KEY=replace-with-the-same-master-key-used-by-the-backend
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-panel-password
ADMIN_PANEL_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars
