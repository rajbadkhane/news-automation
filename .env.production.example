NODE_ENV=production
PORT=3000
TRUST_PROXY_ENABLED=true
DB_DIALECT=mysql

DB_HOST=your-production-mysql-host
DB_PORT=3306
DB_USER=your-production-db-user
DB_PASSWORD=your-production-db-password
DB_NAME=gautam_news_bot

# For Supabase / Postgres use:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# DB_SSL_MODE=require
DB_SSL_MODE=require

# Leave blank on Render when using Puppeteer's bundled browser cache.
BROWSER_EXECUTABLE_PATH=
PUPPETEER_CACHE_DIR=/opt/render/project/src/.puppeteer-cache

SCHEDULER_ENABLED=true
AI_SCHEDULER_ENABLED=true
LEGACY_PUBLIC_ROUTES_ENABLED=false

# Legacy shared key support. Prefer client keys managed through /api/v1/admin/clients.
API_KEYS=
MASTER_API_KEY=replace-with-a-long-random-master-secret-at-least-32-chars

# Comma-separated allowed origins. Do not use * in production.
API_CORS_ORIGINS=https://site-one.com,https://www.site-one.com,https://site-two.com

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
REDIS_URL=replace-with-your-redis-url-for-shared-rate-limits

GEMINI_API_KEY=replace-with-your-production-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Frontend / admin panel
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.onrender.com
ADMIN_PANEL_MASTER_API_KEY=replace-with-the-same-master-key-used-by-the-backend
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-panel-password
ADMIN_PANEL_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars
