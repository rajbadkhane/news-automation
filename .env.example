PORT=3000
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gautam_news_bot
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
SCHEDULER_ENABLED=true
AI_SCHEDULER_ENABLED=true
API_KEYS=replace-with-a-strong-secret-key
MASTER_API_KEY=replace-with-a-strong-master-secret-key
API_CORS_ORIGINS=https://site-one.com,https://site-two.com
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
ADMIN_PANEL_MASTER_API_KEY=replace-with-your-master-api-key
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-panel-password
ADMIN_PANEL_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars

